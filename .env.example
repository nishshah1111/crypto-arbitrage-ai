# Copy this file to .env and replace the placeholders with your own keys.
#   Windows:      copy .env.example .env
#   macOS/Linux:  cp .env.example .env
#
# All keys are OPTIONAL: live public prices work without any keys.
# Placeholder values (starting with "your_") are ignored automatically.
# Never commit your real .env file (it is listed in .gitignore).

# Binance - https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET=your_binance_secret_key_here

# Coinbase - https://www.coinbase.com/settings/api
COINBASE_API_KEY=your_coinbase_api_key_here
COINBASE_SECRET=your_coinbase_api_secret_here

# Kraken - https://www.kraken.com/u/security/api
KRAKEN_API_KEY=your_kraken_api_key_here
KRAKEN_SECRET=your_kraken_private_key_here

# CryptoCompare - https://www.cryptocompare.com/cryptopian/api-keys
CRYPTOCOMPARE_API_KEY=your_cryptocompare_api_key_here

# CoinMarketCap - https://coinmarketcap.com/api/
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key_here

# OpenAI - only needed for main_advanced.py (LangChain mode)
OPENAI_API_KEY=your_openai_api_key_here
